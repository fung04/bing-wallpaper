		"@tailwindcss/vite": "^4.2.1",
		"daisyui": "^5.5.19",
		"flowbite-svelte-blocks": "^2.1.0",
		"gh-pages": "^6.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
