<script lang="ts">
	import { appConfig } from '$lib/stores';
	import { goto } from '$app/navigation';
	import { resolve } from '$app/paths';
	import { onMount, onDestroy } from 'svelte';
	import { tick } from 'svelte';

	const BASE = 'https://bing.npanuhin.me';

	let showLoader = $state(true);
	let showUI = $state(true);
	let showPanel = $state(true);
	let showError = $state(false);

	// data[countryIndex] = array of image objects
	let data: Record<number, any[]> = $state({});

	// per-country current image index
	let globalState: Record<number, number> = $state({});

	let currentCountryIndex = $state(0);

	// Background crossfade: two layers, toggle which is "active"
	let bgA = $state('');
	let bgB = $state('');
	let activeLayer = $state<'a' | 'b'>('a'); // which layer is visible
	let activePanel = $state<'1' | '2'>('1'); // which panel is visible

	// Timer / progress
	let progressPct = $state(0);
	let timerCount = $state(0);
	let intervalSec = $state(30);

	// Interval handles
	let slideshowInterval: ReturnType<typeof setInterval> | null = null;
	let timerInterval: ReturnType<typeof setInterval> | null = null;

	// Today's date string
	let todayStr = $state('');

	// Country label for topbar
	let countryLabel = $state('');

	// Dropdown open state
	let dropdownOpen = $state(false);

	// ---------- lifecycle ----------

	onMount(async () => {
		if (!$appConfig) {
			goto(resolve('/'));
			return;
		}

		console.log('trigger onmount');

		intervalSec = Number($appConfig.intervalSec) || 30;
		timerCount = intervalSec;

		// Format today's date
		todayStr = new Date().toLocaleDateString('en-US', {
			weekday: 'short',
			month: 'short',
			day: 'numeric',
			year: 'numeric'
		});

		await loadImages();

		if (Object.keys(data).length === 0) {
			showLoader = false;
			showError = true;
			return;
		}

		// Initialise per-country indices to 0
		for (let i = 0; i < $appConfig.selectedCountries.length; i++) {
			globalState[i] = 0;
		}

		updateCountryLabel();

		// Set first image URL but don't show UI yet
		await setBackground();

		// Give the background a moment to start its fade before hiding the loader
		showLoader = false;
		showUI = true;
		startSlideshow();
	});

	onDestroy(() => {
		stopSlideshow();
	});

	// ---------- data loading ----------
	async function loadImages() {
		try {
			const now = new Date();
			const year = now.getFullYear();
			const selectedCountries = [...$appConfig.selectedCountries];

			for (let i = 0; i < selectedCountries.length; i++) {
				const country = selectedCountries[i];
				const [countryName, lang] = country.split('-');
				const dataUrl = `${BASE}/${countryName}-${lang}.${year}.min.json`;

				try {
					const res = await fetch(dataUrl);
					if (res.ok) {
						let jsonData = await res.json();
						jsonData = jsonData.slice(-($appConfig.totalImages as number)).reverse();
						data[i] = jsonData;
					}
				} catch (_) {
					// skip failed country
				}
			}
		} catch (err) {
			showLoader = false;
			showError = true;
		}
	}

	// ---------- background image helpers ----------

	function getImageUrl(item: any): string {
		if (!item) return '';
		// Bing archive uses a "url" or "urlbase" field; construct UHD variant
		const base = item.bing_url ?? item.url ?? '';
		const resolution = $appConfig.selectedResolution;
		if (!base) return '';
		if (base.startsWith('http')) {
			const url = base.replace('_UHD', resolution);
			return url;
		}
		return base;
	}

	function preloadNext() {
		const nextIdx = (globalState[currentCountryIndex] ?? 0) + 1;
		const item = data[currentCountryIndex]?.[nextIdx];
		if (!item) return;
		const url = getImageUrl(item);
		if (!url) return;

		const img = new Image();
		img.src = url; // browser caches it silently
	}

	async function setBackground() {
		const idx = globalState[currentCountryIndex] ?? 0;
		const item = data[currentCountryIndex]?.[idx];

		if (!item) return;
		const url = getImageUrl(item);
		if (!url) return;

		await tick();

		const img = new Image();
		img.onload = async () => {
			// 1. Set the background URL to the INACTIVE layer
			if (activeLayer === 'a') {
				bgB = `url("${url}")`;
			} else {
				bgA = `url("${url}")`;
			}

			// 2. Wait for Svelte to update the DOM

			if (activeLayer === 'a') {
				activeLayer = 'b';
				activePanel = '2';
			} else {
				activeLayer = 'a';
				activePanel = '1';
			}
			preloadNext();
		};
		img.src = url;
	}

	// ---------- slideshow ----------

	function startSlideshow() {
		// stopSlideshow();
		progressPct = 0;
		timerCount = intervalSec;

		// Progress / countdown ticker (fires every second)
		timerInterval = setInterval(() => {
			timerCount = Math.max(0, timerCount - 1);
			progressPct = ((intervalSec - timerCount) / intervalSec) * 100;
		}, 1000);

		// Slide advance
		slideshowInterval = setInterval(() => {
			advanceSlide();
		}, intervalSec * 1000);
	}

	function stopSlideshow() {
		console.log('reset');
		if (slideshowInterval) clearInterval(slideshowInterval);
		if (timerInterval) clearInterval(timerInterval);
		slideshowInterval = null;
		timerInterval = null;
	}

	function advanceSlide() {
		const total = data[currentCountryIndex]?.length ?? 0;
		if (total === 0) return;
		globalState[currentCountryIndex] = (globalState[currentCountryIndex] + 1) % total;
		setBackground();
		progressPct = 0;
		timerCount = intervalSec;
	}

	function prevSlide() {
		const total = data[currentCountryIndex]?.length ?? 0;
		if (total === 0) return;
		globalState[currentCountryIndex] = (globalState[currentCountryIndex] - 1 + total) % total;
		setBackground();
		// Reset timer on manual navigation
		progressPct = 0;
		timerCount = intervalSec;
		startSlideshow();
	}

	function nextSlide() {
		advanceSlide();
		startSlideshow();
	}

	// ---------- reactive derived values ----------

	function getCurrentItem() {
		return data[currentCountryIndex]?.[globalState[currentCountryIndex] ?? 0] ?? null;
	}

	function getField(field: string): string {
		const item = getCurrentItem();
		if (!item) return '';
		return item[field] ?? '';
	}

	function totalImages(): number {
		return data[currentCountryIndex]?.length ?? 0;
	}

	function currentImageNum(): number {
		return (globalState[currentCountryIndex] ?? 0) + 1;
	}

	// ---------- country selector ----------

	function updateCountryLabel() {
		const countries = $appConfig.selectedCountries as string[];
		if (!countries?.length) return;
		const c = countries[currentCountryIndex];
		if (!c) return;
		const [region, lang] = c.split('-');
		countryLabel = `${region.toUpperCase()} — ${lang.charAt(0).toUpperCase() + lang.slice(1)}`;
	}

	function selectCountry(index: number) {
		currentCountryIndex = index;
		updateCountryLabel();
		setBackground();
		progressPct = 0;
		timerCount = intervalSec;
		startSlideshow();
		dropdownOpen = false;
	}

	function countryDisplayName(c: string): string {
		const [region, lang] = c.split('-');
		return `${region.toUpperCase()} — ${lang.charAt(0).toUpperCase() + lang.slice(1)}`;
	}

	// ---------- tab visibility ----------

	function handleVisibilityChange() {
		if (document.hidden) {
			stopSlideshow();
		} else {
			// Rotate to next country on tab resume (original feature intent)
			currentCountryIndex =
				(currentCountryIndex + 1) % ($appConfig.selectedCountries as string[]).length;
			updateCountryLabel();
			setBackground();
			startSlideshow();
		}
	}

	// Close dropdown when clicking outside
	function handleDocClick(e: MouseEvent) {
		const target = e.target as HTMLElement;
		if (!target.closest('#country-wrap')) {
			dropdownOpen = false;
		}
	}
</script>

<svelte:document on:visibilitychange={handleVisibilityChange} on:click={handleDocClick} />

<!-- ══════════════════════════════════ Loader ══ -->
{#if showLoader}
	<div id="loader">
		<div class="loader-ring"></div>
		<div class="loader-text">Loading wallpaper</div>
	</div>
{:else}
	<!-- ══════════════════════════════════ Background ══ -->
	<div id="bg-wrap">
		<div
			class="bg-img"
			id="bg-a"
			class:visible={activeLayer === 'a'}
			class:hidden={activeLayer !== 'a'}
			style:background-image={bgA}
		></div>
		<div
			class="bg-img"
			id="bg-b"
			class:visible={activeLayer === 'b'}
			class:hidden={activeLayer !== 'b'}
			style:background-image={bgB}
		></div>
		<div id="bg-overlay"></div>
	</div>
{/if}
<!-- ══════════════════════════════════ Error ══ -->
{#if showError}
	<div id="error-msg" class="visible">
		<div class="err-icon">◌</div>
		<div class="err-title">No Wallpaper Found</div>
		<div class="err-text">Could not retrieve images for this region. Try a different country.</div>
	</div>
{/if}

<!-- ══════════════════════════════════ UI ══ -->
{#if showUI}
	<div id="ui" class:visible={showUI}>
		<!-- Top bar -->
		<div id="topbar">
			<div id="country-wrap">
				<button
					id="country-btn"
					class:open={dropdownOpen}
					onclick={() => (dropdownOpen = !dropdownOpen)}
				>
					<span id="country-label">{countryLabel}</span>
					<svg width="12" height="8" viewBox="0 0 12 8" fill="none">
						<path
							d="M1 1l5 5 5-5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
						/>
					</svg>
				</button>

				<div id="country-dropdown" class:open={dropdownOpen}>
					{#each $appConfig.selectedCountries as string[] as country, i}
						<div
							class="dropdown-item"
							class:active={i === currentCountryIndex}
							onclick={() => selectCountry(i)}
						>
							<span>{countryDisplayName(country)}</span>
							<span class="locale-code">{country}</span>
						</div>
					{/each}
					<div class="dropdown-item" onclick={() => goto('/')}>Edit</div>
				</div>
			</div>

			<div id="today-date">
				<div class="day-label">Today</div>
				<div class="day-value" id="today-val">{todayStr}</div>
			</div>
		</div>

		<!-- Bottom info -->
		<div id="bottom">
			<div
				class="info-panel"
				class:visible={activePanel === '1'}
				class:hidden={activePanel !== '1'}
				id="info-panel-1"
			>
				<div id="title-line"></div>
				<div id="img-title">{getField('title')}</div>
				<div id="img-caption">{getField('caption')}</div>
				<div id="img-description">{getField('description')}</div>
				<div id="img-meta">
					<div id="img-date-badge">{getField('date')}</div>
					<div id="img-copyright">{getField('copyright')}</div>
				</div>
			</div>
			<div
				class="info-panel"
				class:visible={activePanel === '2'}
				class:hidden={activePanel !== '2'}
				id="info-panel-2"
			>
				<div id="title-line"></div>
				<div id="img-title">{getField('title')}</div>
				<div id="img-caption">{getField('caption')}</div>
				<div id="img-description">{getField('description')}</div>
				<div id="img-meta">
					<div id="img-date-badge">{getField('date')}</div>
					<div id="img-copyright">{getField('copyright')}</div>
				</div>
			</div>

			<div id="right-controls">
				<div id="timer-wrap">
					<div id="timer-label">Next in</div>
					<div id="progress-track">
						<div id="progress-fill" style:width="{progressPct}%"></div>
					</div>
					<div id="timer-count">{timerCount}s</div>
				</div>

				<div id="img-counter">
					<span id="cur-idx">{currentImageNum()}</span>
					/
					<span id="total-idx">{totalImages()}</span>
				</div>

				<div id="nav-btns">
					<button
						class="nav-btn"
						id="btn-prev"
						title="Previous"
						onclick={prevSlide}
						disabled={totalImages() <= 1}>‹</button
					>
					<button
						class="nav-btn"
						id="btn-next"
						title="Next"
						onclick={nextSlide}
						disabled={totalImages() <= 1}>›</button
					>
				</div>
			</div>
		</div>
	</div>
{/if}

<style>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:global(:root) {
		--gold: #c9a84c;
		--cream: #f5f0e8;
		--dark: #0a0a0a;
		--glass: rgba(10, 10, 10, 0.55);
		--glass-border: rgba(201, 168, 76, 0.25);
		--transition: 1.5s cubic-bezier(0.33, 1, 0.68, 1);
	}

	html,
	body {
		width: 100%;
		height: 100%;
		overflow: hidden;
		background: #0a0a0a;
		font-family: 'Geist Mono', monospace;
		color: var(--cream);
	}

	/* ── Background layer ── */
	#bg-wrap {
		position: fixed;
		background-color: var(--dark);
		inset: 0;
		z-index: 0;
	}

	.bg-img {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		transition: opacity var(--transition);
	}

	.bg-img.hidden {
		opacity: 0;
	}

	.bg-img.visible {
		opacity: 1;
	}

	#bg-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.82) 0%,
			rgba(0, 0, 0, 0.35) 40%,
			rgba(0, 0, 0, 0.12) 70%,
			rgba(0, 0, 0, 0.08) 100%
		);
		z-index: 1;
	}

	/* ── Loading state ── */
	#loader {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: var(--dark);
		transition: opacity 0.6s ease;
	}

	#loader.fade-out {
		opacity: 0;
		pointer-events: none;
	}

	.loader-ring {
		width: 48px;
		height: 48px;
		border: 2px solid rgba(201, 168, 76, 0.2);
		border-top-color: var(--gold);
		border-radius: 50%;
		animation: spin 1s linear infinite;
		margin-bottom: 18px;
	}

	.loader-text {
		font-size: 11px;
		letter-spacing: 0.2em;
		color: rgba(201, 168, 76, 0.6);
		text-transform: uppercase;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* ── UI Shell ── */
	#ui {
		position: fixed;
		inset: 0;
		z-index: 10;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 28px 36px 36px;
		opacity: 0;
		transition: opacity 0.8s ease;
		pointer-events: none;
	}

	#ui.visible {
		opacity: 1;
		pointer-events: all;
	}

	/* ── Top bar ── */
	#topbar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 20px;
	}

	/* Country Selector */
	#country-wrap {
		position: relative;
	}

	#country-btn {
		display: flex;
		align-items: center;
		gap: 10px;
		background: var(--glass);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(18px);
		color: var(--cream);
		font-family: 'Geist Mono', monospace;
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		padding: 10px 16px;
		cursor: pointer;
		border-radius: 3px;
		transition:
			border-color 0.3s,
			background 0.3s;
	}

	#country-btn:hover {
		border-color: var(--gold);
		background: rgba(10, 10, 10, 0.75);
	}

	#country-btn svg {
		opacity: 0.6;
		transition: transform 0.3s;
	}

	#country-btn.open svg {
		transform: rotate(180deg);
	}

	#country-dropdown {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		min-width: 220px;
		background: rgba(8, 8, 8, 0.92);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(24px);
		border-radius: 3px;
		overflow: hidden;
		display: none;
		z-index: 50;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
	}

	#country-dropdown.open {
		display: block;
		animation: dropIn 0.25s ease;
	}

	@keyframes dropIn {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.dropdown-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 11px 16px;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		cursor: pointer;
		color: rgba(245, 240, 232, 0.7);
		transition:
			background 0.2s,
			color 0.2s;
		gap: 16px;
	}

	.dropdown-item:hover {
		background: rgba(201, 168, 76, 0.1);
		color: var(--cream);
	}

	.dropdown-item.active {
		color: var(--gold);
	}

	.dropdown-item .locale-code {
		font-size: 10px;
		color: rgba(201, 168, 76, 0.5);
	}

	/* Today's date */
	#today-date {
		text-align: right;
	}

	#today-date .day-label {
		font-size: 10px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgba(245, 240, 232, 0.4);
		margin-bottom: 4px;
	}

	#today-date .day-value {
		font-family: 'Playfair Display', serif;
		font-size: clamp(15px, 2vw, 22px);
		font-weight: 400;
		color: var(--cream);
		line-height: 1.1;
	}

	/* ── Bottom info panel ── */
	#bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.info-panel {
		max-width: 900px;
		display: none;
	}
	.info-panel.visible {
		display: block;
		animation: slideUp 0.6s ease both;
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(24px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	#img-title {
		font-family: 'Playfair Display', serif;
		font-size: clamp(24px, 4.5vw, 56px);
		font-weight: 700;
		line-height: 1.05;
		color: var(--cream);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.7);
		margin-bottom: 10px;
	}

	#img-caption {
		font-size: 12px;
		letter-spacing: 0.1em;
		color: rgba(245, 240, 232, 0.65);
		margin-bottom: 8px;
		line-height: 1.6;
	}

	#img-description {
		font-size: 12px;
		letter-spacing: 0.05em;
		color: rgba(245, 240, 232, 0.5);
		line-height: 1.7;
		max-width: 580px;
		max-height: 250px;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 15; /* Limits text to 3 lines */
	}

	#img-meta {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 14px;
	}

	#img-date-badge {
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
		border: 1px solid rgba(201, 168, 76, 0.35);
		padding: 5px 10px;
		border-radius: 2px;
		backdrop-filter: blur(8px);
		background: rgba(201, 168, 76, 0.06);
	}

	#img-copyright {
		font-size: 10px;
		letter-spacing: 0.1em;
		color: rgba(245, 240, 232, 0.3);
	}

	/* ── Right controls ── */
	#right-controls {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 16px;
	}

	/* Progress / Timer */
	#timer-wrap {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 8px;
	}

	#timer-label {
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(201, 168, 76, 0.5);
	}

	#progress-track {
		width: 120px;
		height: 2px;
		background: rgba(255, 255, 255, 0.12);
		border-radius: 1px;
		overflow: hidden;
	}

	#progress-fill {
		height: 100%;
		background: var(--gold);
		border-radius: 1px;
		transition: width 1s linear;
		width: 0%;
	}

	#timer-count {
		font-size: 10px;
		letter-spacing: 0.15em;
		color: rgba(201, 168, 76, 0.45);
	}

	/* Image counter */
	#img-counter {
		font-size: 11px;
		letter-spacing: 0.18em;
		color: rgba(245, 240, 232, 0.35);
	}

	#img-counter span {
		color: var(--cream);
	}

	/* Nav buttons */
	#nav-btns {
		display: flex;
		gap: 10px;
	}

	.nav-btn {
		width: 40px;
		height: 40px;
		background: var(--glass);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(14px);
		color: var(--cream);
		cursor: pointer;
		border-radius: 2px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 16px;
		transition:
			border-color 0.25s,
			background 0.25s,
